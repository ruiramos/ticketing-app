// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

model Event {
  id           String        @id @default(uuid())
  title        String
  text         String
  location     String?
  link         String?
  image        String?
  variants     Variant[]
  eventExtras  EventExtras[]
  customFields Json?

  startsAt DateTime  @default(now())
  endsAt   DateTime?

  enabled Boolean @default(false)

  // To return `Date`s intact through the API we use transformers
  // https://trpc.io/docs/v11/data-transformers
  // This is unique so it can be used for cursor-based pagination
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  orders         Order[]
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
}

model Variant {
  id           String @id @default(uuid())
  title        String
  stock        Int
  price        Float
  currency     String
  displayOrder Int    @default(autoincrement())

  event   Event   @relation(fields: [eventId], references: [id])
  eventId String
  orders  Order[]
}

model EventExtras {
  id    String @id @default(uuid())
  title String

  description String?

  price    Float?
  currency String?

  multiple      Boolean @default(false)
  multipleLimit Int?

  event   Event  @relation(fields: [eventId], references: [id])
  eventId String
}

enum OrderStatus {
  RESERVED
  CONFIRMED
  CANCELLED
  EXPIRED
}

model Order {
  id                    String  @id @default(uuid())
  externalId            String?
  externalTransactionId String?

  event   Event  @relation(fields: [eventId], references: [id])
  eventId String

  variant   Variant @relation(fields: [variantId], references: [id])
  variantId String
  quantity  Int

  status OrderStatus

  selectedExtras       Json
  items                Json
  customer             Json
  customFieldResponses Json?
  error                Json?

  checkedIn   Boolean?  @default(false)
  checkedInAt DateTime?

  amount   Float
  currency String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
}

model Organization {
  id       String  @id @default(uuid())
  name     String
  email    String
  phone    String?
  address  String?
  city     String?
  postCode String?
  website  String?
  logoUrl  String?

  events      Event[]
  invitations OrganizationInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  users     User[]
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model OrganizationInvitation {
  id     String           @id @default(uuid())
  email  String
  name   String
  role   Role             @default(USER)
  token  String           @unique
  status InvitationStatus @default(PENDING)

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  invitedBy   User   @relation(fields: [invitedById], references: [id])
  invitedById String

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model User {
  id      String  @id @default(uuid())
  email   String // TODO unique???
  role    Role    @default(USER)
  name    String?
  phone   String?
  address String?

  orders         Order[]
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  sentInvitations OrganizationInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum Role {
  USER
  ADMIN
}
