{
  "title": "Ticketing app",
  "uid": "ticketing-app",
  "tags": [
    "ticketing"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prom",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "regex": ".*grafanacloud.*prom.*"
      },
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "regex": ".*grafanacloud.*logs.*"
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prom}"
        },
        "query": {
          "query": "label_values(ticketing_trpc_requests_total, namespace)",
          "refId": "ns"
        },
        "definition": "label_values(ticketing_trpc_requests_total, namespace)",
        "refresh": 2
      },
      {
        "name": "traefik_service",
        "label": "Traefik service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prom}"
        },
        "query": {
          "query": "label_values(traefik_service_requests_total{service=~\".*ticketing.*\"}, service)",
          "refId": "ts"
        },
        "definition": "label_values(traefik_service_requests_total{service=~\".*ticketing.*\"}, service)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*ticketing.*"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Sales",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Tickets sold",
      "description": "Tickets in orders confirmed in the selected time range",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ticketing_tickets_sold_total{namespace=\"$namespace\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Revenue",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ticketing_revenue_total{namespace=\"$namespace\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Orders confirmed",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ticketing_orders_confirmed_total{namespace=\"$namespace\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Reservations made",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ticketing_orders_reserved_total{namespace=\"$namespace\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Reservations expired",
      "description": "From the expire-reserved CronJob's per-run summary log line",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum_over_time({namespace=\"$namespace\", job=\"ticketing-expire-reserved\"} | json | msg=\"expire-reserved run complete\" | unwrap expired [$__range]))",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "instant": true,
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "id": 6
    },
    {
      "type": "stat",
      "title": "Payment failures",
      "description": "PayPal capture failed, or payment taken but saving the order failed",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ticketing_order_capture_failures_total{namespace=\"$namespace\", stage=~\"payment|post_capture\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Order flow (per 5m)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ticketing_orders_reserved_total{namespace=\"$namespace\"}[5m]))",
          "legendFormat": "reserved",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        },
        {
          "refId": "B",
          "expr": "sum(increase(ticketing_orders_confirmed_total{namespace=\"$namespace\"}[5m]))",
          "legendFormat": "confirmed",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Reservations expired (per 5m)",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum_over_time({namespace=\"$namespace\", job=\"ticketing-expire-reserved\"} | json | msg=\"expire-reserved run complete\" | unwrap expired [5m]))",
          "legendFormat": "expired",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Order failures (per 5m)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(ticketing_order_reservation_failures_total{namespace=\"$namespace\"}[5m]))",
          "legendFormat": "reserve: {{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (stage) (increase(ticketing_order_capture_failures_total{namespace=\"$namespace\"}[5m]))",
          "legendFormat": "capture: {{stage}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "PayPal API",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(ticketing_paypal_request_duration_seconds_bucket{namespace=\"$namespace\"}[5m])))",
          "legendFormat": "p95 {{operation}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 13
      },
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "PayPal & email errors (per 5m)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (increase(ticketing_paypal_requests_total{namespace=\"$namespace\", outcome=\"error\"}[5m]))",
          "legendFormat": "paypal {{operation}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        },
        {
          "refId": "B",
          "expr": "sum(increase(ticketing_emails_total{namespace=\"$namespace\", outcome=\"failed\"}[5m]))",
          "legendFormat": "email failed",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 13
      },
      "id": 12
    },
    {
      "type": "row",
      "title": "Traffic",
      "id": 13,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "HTTP responses by status (ingress)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(traefik_service_requests_total{service=~\"$traefik_service\"}[5m]))",
          "legendFormat": "{{code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 22
      },
      "id": 14
    },
    {
      "type": "timeseries",
      "title": "tRPC calls by result",
      "description": "Per procedure call, so errors inside batched (HTTP 207) requests are counted",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(ticketing_trpc_requests_total{namespace=\"$namespace\"}[5m]))",
          "legendFormat": "{{code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 22
      },
      "id": 15
    },
    {
      "type": "timeseries",
      "title": "tRPC errors by procedure",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (procedure, code) (rate(ticketing_trpc_requests_total{namespace=\"$namespace\", code!=\"OK\"}[5m]))",
          "legendFormat": "{{procedure}} {{code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 22
      },
      "id": 16
    },
    {
      "type": "timeseries",
      "title": "Ingress latency p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=~\"$traefik_service\"}[5m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=~\"$traefik_service\"}[5m])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "id": 17
    },
    {
      "type": "timeseries",
      "title": "Slowest tRPC procedures (p95)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, histogram_quantile(0.95, sum by (le, procedure) (rate(ticketing_trpc_request_duration_seconds_bucket{namespace=\"$namespace\"}[5m]))))",
          "legendFormat": "{{procedure}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "id": 18
    },
    {
      "type": "row",
      "title": "Containers",
      "id": 19,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU (cores)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", container=\"ticketing-app\"}[5m]))",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        },
        {
          "refId": "B",
          "expr": "max(kube_pod_container_resource_limits{namespace=\"$namespace\", container=\"ticketing-app\", resource=\"cpu\"})",
          "legendFormat": "limit",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
